#!/usr/bin/env bash

# Visualize network bandwidth on a host

declare -A DATA=()

if [[ -z $NO_COLOR ]]; then
	COLOR=$'\e[36m'
	DIM=$'\e[2m'
	RST=$'\e[0m'
else
	COLOR=
	DIM=
	RST=
fi

TITLEFMT="$DIM%15s %15s %15s %15s$RST\\n"
DATAFMT="$COLOR%15s$RST %15s %15s %15s\\n"

fatal() {
	echo '[FATAL]' "@" >&2
	exit 1
}

format-bits() {
	local bits=$1

	if ((bits > 1000000)); then
		echo "$((bits / 1000000)) mbps"
	elif ((bits > 1000)); then
		echo "$((bits / 1000)) kbps"
	else
		echo "$bits  bps"
	fi
}

process-iface() {
	local iface=$1
	local rx_bytes=$2		
	local tx_bytes=$3

	local old=${DATA[$iface]}

	DATA[$iface]="$rx_bytes $tx_bytes"

	if [[ -z $old ]]; then
		echo "> $iface old data not found"
		return 1
	fi

	local old_rx_bytes old_tx_bytes
	read -r old_rx_bytes old_tx_bytes <<< "$old"

	local d_rx_bits=$(((rx_bytes - old_rx_bytes) * 8))
	local d_tx_bits=$(((tx_bytes - old_tx_bytes) * 8))
	local d_total_bits=$(((d_rx_bytes + d_tx_bytes * 8)))
	
	local rx=$(format-bits "$d_rx_bits")
	local tx=$(format-bits "$d_tx_bits")
	local total=$(format-bits "$d_total_bits")
	
	printf "$DATAFMT" "$iface" "$rx" "$tx" "$total"
}

enable-alt-buffer() {
	printf '\e[?1049h' # enable alternate buffer
	printf '\e[?25l' # hide the cursor
}

disable-alt-buffer() {
	printf '\e[?1049l' # disable alternate buffer
	printf '\e[?25h' # show the cursor
}

main() {
	trap disable-alt-buffer EXIT
	enable-alt-buffer

	while true; do	
		printf '\e[H' # move the cursor home

		mapfile -s 2 -t  lines < /proc/net/dev || fatal 'failed to read proc device'
		
		echo 
		printf "$TITLEFMT" "INTERFACE" "RECEIVE" "TRANSMIT" "TOTAL"


		local line
		for line in "${lines[@]}"; do 
			
			local -a info
			read -ra info <<< "$line"

			local iface=${info[0]%:}
			local rx_bytes=${info[1]%:}
			local tx_bytes=${info[9]%:}

			process-iface "$iface" "$rx_bytes" "$tx_bytes"

		done

		sleep 1

	done
}

main "$0"
